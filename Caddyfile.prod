{$DOMAIN} {
    # Enable automatic HTTPS with Let's Encrypt
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
    }

    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google.com; frame-src 'self' https://www.google.com;"
    }

    # API and admin routes to Django
    handle /api/* {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    
    handle /admin/* {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static files
    handle /static/* {
        root * /srv
        file_server
        header Cache-Control "public, max-age=31536000"
    }

    # Media files
    handle /media/* {
        root * /srv
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # Sitemap and robots
    handle /sitemap.xml {
        reverse_proxy web:8000
    }

    handle /robots.txt {
        reverse_proxy web:8000
    }

    # RSS feed
    handle /rss.xml {
        reverse_proxy web:8000
    }

    # Frontend (React app)
    handle {
        root * /srv/static
        try_files {path} /index.html
        file_server
        header Cache-Control "public, max-age=3600"
    }
}
